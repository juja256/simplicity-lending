# Copy to .env and fill in values.
# For liquid mainnet use .env.liquid, for testnet use .env.liquidtestnet as a starting point.

VITE_API_URL=http://localhost:8000
# For local development against a remote API, use VITE_API_URL=/api and set:
# API_PROXY_TARGET=https://lending.dev.blockstream.com
# For a local indexer, which serves at / and sends no CORS headers, also set
# API_PROXY_TARGET=http://127.0.0.1:8000 and API_PROXY_STRIP_PREFIX=true (see README).
VITE_NETWORK=liquid
VITE_ESPLORA_BASE_URL=https://blockstream.info/liquid
VITE_WATERFALLS_URL=https://waterfalls.liquidwebwallet.org/liquid/api
# Optional pin of the waterfalls server's age key. Unset, the app fetches it from
# <VITE_WATERFALLS_URL>/v1/server_recipient, so a key rotation needs no change.
# VITE_WATERFALLS_RECIPIENT=
VITE_PRICES_BASE_URL=https://green-liquid-testnet.blockstream.com

# Optional: enables explicit test-seed login and short test offers.
# Requires VITE_NETWORK=liquidtestnet or regtest. Never embed seeds in environment files.
# Use `pnpm build:demo` for the bundled Liquid testnet demo configuration.
# VITE_DEMO_MODE=true

# Optional: experimental SideSwap wallet connect (testnet only, needs a SideSwap dev
# build to sign — see https://sideswap.io/download/). Unset disables the connect option.
# VITE_SIDESWAP_WS_URL=wss://api-testnet.sideswap.io/server-connect

# Optional: Google Analytics measurement ID, one property per network.
# Unset disables analytics entirely.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: public origin of the deployment, used for absolute og:image URLs
# in link previews. Unset keeps the URL relative.
# VITE_PUBLIC_URL=https://lending.dev.blockstream.com
