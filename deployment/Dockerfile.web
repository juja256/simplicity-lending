FROM rust:1-bookworm AS wasm

RUN apt-get update && apt-get install -y --no-install-recommends clang && \
    rm -rf /var/lib/apt/lists/* && \
    rustup target add wasm32-unknown-unknown && \
    cargo install wasm-pack --locked

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

WORKDIR /app/web
RUN wasm-pack build ../crates/private-lending-wasm --release --target web \
        --out-dir ../../web/src/wasm/private-lending --out-name private_lending_wasm && \
    rm -f src/wasm/private-lending/.gitignore src/wasm/private-lending/package.json

FROM node:22-bookworm AS builder

WORKDIR /app/web
RUN corepack enable && \
    corepack prepare pnpm@10.33.0 --activate

COPY web/package.json web/pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY web ./
COPY crates/contracts/simf /app/crates/contracts/simf
COPY --from=wasm /app/web/src/wasm/private-lending ./src/wasm/private-lending

ARG VITE_API_URL
ARG VITE_ESPLORA_BASE_URL
ARG VITE_NETWORK
ARG VITE_WATERFALLS_URL
ARG VITE_WATERFALLS_RECIPIENT=age1ajng86w5g0qleku0k7eqjre5l7e6qaynjrnlyuc08w3ddu0etdcs379rr3
ARG VITE_DEMO_MODE
ARG VITE_DEBUG_MNEMONIC
ARG VITE_SIDESWAP_WS_URL
ARG VITE_GA_MEASUREMENT_ID
ARG VITE_PUBLIC_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ESPLORA_BASE_URL=$VITE_ESPLORA_BASE_URL
ENV VITE_NETWORK=$VITE_NETWORK
ENV VITE_WATERFALLS_URL=$VITE_WATERFALLS_URL
ENV VITE_WATERFALLS_RECIPIENT=$VITE_WATERFALLS_RECIPIENT
ENV VITE_DEMO_MODE=$VITE_DEMO_MODE
ENV VITE_DEBUG_MNEMONIC=$VITE_DEBUG_MNEMONIC
ENV VITE_SIDESWAP_WS_URL=$VITE_SIDESWAP_WS_URL
ENV VITE_GA_MEASUREMENT_ID=$VITE_GA_MEASUREMENT_ID
ENV VITE_PUBLIC_URL=$VITE_PUBLIC_URL

RUN pnpm build

FROM nginx:1.27-alpine

RUN apk add --no-cache gettext

COPY --from=builder /app/web/dist /usr/share/nginx/html
COPY deployment/configs /deployment/configs
COPY deployment/scripts/render-web-config.sh /deployment/render-web-config.sh

ENTRYPOINT ["/deployment/render-web-config.sh"]
CMD ["nginx", "-g", "daemon off;"]
