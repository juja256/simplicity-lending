server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json application/wasm;

  location = /api {
    return 301 /api/;
  }

  # TODO: Remove after BE fix — the indexer doesn't proxy this itself, so we
  # forward straight to the upstream price API here instead of /api/.
  location ^~ /api/prices/ {
    proxy_pass ${WEB_PRICES_API_UPSTREAM}/prices/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_redirect off;
  }

  # Deliver block notifications immediately; buffering delays private-loan refreshes.
  location = /api/events {
    proxy_pass http://api:8000/events;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location /api/ {
    proxy_pass http://api:8000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Asset registries verify issuer domain ownership by fetching
  # https://<domain>/.well-known/liquid-asset-proof-<asset_id> at the domain
  # root, so this must reach the backend (which serves proofs only for assets
  # it verified), not the SPA fallback.
  location ^~ /.well-known/liquid-asset-proof- {
    proxy_pass http://api:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /esplora {
    return 301 /esplora/;
  }

  location /esplora/ {
    proxy_pass ${WEB_ESPLORA_API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_redirect off;
  }

  # Vite content hashes make these assets safe to cache across releases.
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
