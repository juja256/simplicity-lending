application:
  port: 8000
database:
  host: "${POSTGRES_HOST}"
  port: ${POSTGRES_PORT}
  username: "${POSTGRES_USER}"
  password: "${POSTGRES_PASSWORD}"
  database_name: "${POSTGRES_DB}"
esplora:
  base_url: "${INDEXER_ESPLORA_BASE_URL}"
  timeout: 10
  network: "${VITE_NETWORK}"
indexer:
  protocol_fee_keeper_asset_id: "${PROTOCOL_FEE_KEEPER_ASSET_ID}"
  interval: ${INDEXER_POLL_INTERVAL_MS}
  last_indexed_height: ${INDEXER_LAST_INDEXED_HEIGHT}
  asset_registry:
    domain: "${ASSET_REGISTRY_DOMAIN}"
    registry_url: "${ASSET_REGISTRY_URL}"
