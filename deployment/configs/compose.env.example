# Replace with your own HTTPS origin; TLS terminates at your external reverse proxy.
PUBLIC_ORIGIN=https://lending.example.com
WEB_PORT=8080

VITE_API_URL=/api
VITE_ESPLORA_BASE_URL=https://blockstream.info/liquidtestnet
VITE_NETWORK=liquidtestnet
VITE_WATERFALLS_URL=https://waterfalls-elements-testnet.esplora.staging.blockstream.io:17771
# Optional: pin the waterfalls server's age key. Unset, the app fetches it from the server.
# VITE_WATERFALLS_RECIPIENT=
# Explicit test-seed login and short test terms for this Liquid testnet demo.
# Mainnet builds reject demo mode. Seeds must never be supplied as build args.
VITE_DEMO_MODE=true
# VITE_SIDESWAP_WS_URL enables the experimental SideSwap wallet connect option; leave unset to disable it.
# VITE_SIDESWAP_WS_URL=wss://api-testnet.sideswap.io/server-connect
# VITE_GA_MEASUREMENT_ID enables Google Analytics, one property per network;
# leave unset to disable it.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

INDEXER_ESPLORA_BASE_URL=https://blockstream.info/liquidtestnet/api
WEB_ESPLORA_API_UPSTREAM=https://blockstream.info/liquidtestnet/api
WEB_PRICES_API_UPSTREAM=https://green-liquid-testnet.blockstream.com
INDEXER_POLL_INTERVAL_MS=10000
PROTOCOL_FEE_KEEPER_ASSET_ID=38fca2d939696061a8f76d4e6b5eecd54e3b4221c846f24a6b279e79952850a5
# Used only for an empty database: scanning starts at the following block.
# Keep below the earliest public/private offer you need to discover.
INDEXER_LAST_INDEXED_HEIGHT=2497352

# ELIP-0100 asset metadata for factory assets issued by the lending flow.
ASSET_REGISTRY_DOMAIN=lending.example.com

# Leave ASSET_REGISTRY_URL empty to disable registry submission.
ASSET_REGISTRY_URL=https://assets-testnet.blockstream.info

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lending-indexer
POSTGRES_USER=app
# Replace before starting the stack. Use a URL-safe value for the migration connection URL.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
