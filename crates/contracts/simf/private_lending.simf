/*
 * PRIVATE LENDING
 *
 * The lending protocol of lending.simf with confidential collateral, principal and repayment.
 * Their assets and amounts never appear on chain, neither in outputs nor in the program: every
 * term is a pinned commitment, the SHA-256 of the output's confidential asset and amount
 * (`asset_amount_hash`), whose blinding factors are fixed when the offer is created. The borrower
 * derives them from a secret it shares with the chosen lender, so both parties can open every
 * output the covenant pins and the lender can check the terms before funding. Each pinned output's
 * range proof is also rewindable with its recipient's blinding key.
 *
 * The storage has the two slots of lending.simf: whether the offer is active, and the debt. The
 * debt is a curve point D = d·A + r·G, with A the asset commitment of the pinned repayment, d the
 * amount still owed and r its blinder, and the slot holds h(A, D), the SHA-256 of the consensus
 * encodings of A and D. It is REPAYMENT_COMMITMENT from creation until the first installment.
 *
 * Differences from lending.simf:
 * - Terms are pinned commitments, not explicit assets, amounts and an interest rate.
 * - No protocol fee. The interest is folded into the repayment commitment; the lender checks its
 *   opening once, off chain, before accepting the offer.
 * - An installment pays any amount, hidden in a value commitment V under A, and releases no
 *   collateral: the program computes the debt left, D' = D − V, and moves the loan to the storage
 *   of h(A, D'). The full repayment pays an output equal to the debt, so the installments and the
 *   full repayment add up to the repayment of the terms. A debt of no amount, which no output can
 *   carry, closes by revealing its blinder k, with k·G = ±D. There is no vault: the repayment and
 *   the installments go to asset_auth outputs of the lender NFT.
 * - Each installment re-blinds the collateral by a public step: its asset commitment moves by G
 *   and its value commitment stays, which proves the same asset and amount without opening it.
 *   An unchanged asset commitment would need a surjection proof with a zero blinding difference.
 * - The expiry is not in the program: it holds EXPIRY_HASH, the SHA-256 of a salt and the expiry,
 *   and the liquidation's witness reveals both.
 *
 * Pinning compares the consensus encoding of the commitments byte for byte, so it needs no
 * decoding, and the negated commitment (another prefix byte) does not pass. The installment does
 * decode points. Elements sets a commitment's prefix bit exactly when y is not a square, while
 * jet::decompress reads that bit as the parity of y, so the program converts by testing whether
 * y is a square.
 */

// Helper getters

fn get_script_hash(index: u32, is_input_index: bool) -> u256 {
    let script_hash: u256 = match is_input_index {
        true => unwrap(jet::input_script_hash(index)),
        false => unwrap(jet::output_script_hash(index)),
    };

    script_hash
}

fn get_explicit_asset_and_amount(index: u32, is_input_index: bool) -> (u256, u64) {
    let pair: (Asset1, Amount1) = match is_input_index {
        true => unwrap(jet::input_amount(index)),
        false => unwrap(jet::output_amount(index)),
    };
    let (asset, amount): (Asset1, Amount1) = pair;
    let asset_bits: u256 = unwrap_right::<(u1, u256)>(asset);
    let amount: u64 = unwrap_right::<(u1, u256)>(amount);
    (asset_bits, amount)
}

// The asset and value commitments of a confidential input or output, each in Elements' encoding:
// the low bit of the prefix, and x
fn get_confidential_asset_and_amount(index: u32, is_input_index: bool) -> ((u1, u256), (u1, u256)) {
    let pair: (Asset1, Amount1) = match is_input_index {
        true => unwrap(jet::input_amount(index)),
        false => unwrap(jet::output_amount(index)),
    };
    let (asset, amount): (Asset1, Amount1) = pair;
    let asset_commitment: (u1, u256) = unwrap_left::<u256>(asset);
    let value_commitment: (u1, u256) = unwrap_left::<u64>(amount);
    (asset_commitment, value_commitment)
}

// SHA-256 of the consensus encoding of the asset and the amount (explicit or confidential)
fn get_asset_and_amount_hash(index: u32, is_input_index: bool) -> u256 {
    let pair: (Asset1, Amount1) = match is_input_index {
        true => unwrap(jet::input_amount(index)),
        false => unwrap(jet::output_amount(index)),
    };
    let (asset, amount): (Asset1, Amount1) = pair;

    let hash_ctx1: Ctx8 = jet::sha_256_ctx_8_init();
    let hash_ctx2: Ctx8 = jet::asset_amount_hash(hash_ctx1, asset, amount);

    jet::sha_256_ctx_8_finalize(hash_ctx2)
}

// A commitment in Elements' encoding, the low bit of its prefix and x, from the form the witness
// and the parameters carry it in: whether that bit is set, and x. (Simplex cannot pass a u1 of 0
// from Rust, so they carry a bool, the same one bit.)
fn get_commitment(prefix_bit_and_x: (bool, u256)) -> (u1, u256) {
    let (prefix_bit, x): (bool, u256) = prefix_bit_and_x;

    (<bool>::into(prefix_bit), x)
}

// A, the asset commitment of the pinned repayment, which every installment and repayment carries
fn get_repayment_asset() -> (u1, u256) {
    get_commitment(param::REPAYMENT_ASSET)
}

// h(A, D): SHA-256 of the consensus encodings of the repayment asset A and the debt D, the hash a
// repayment output that carries D has
fn get_debt_hash(debt: (u1, u256)) -> u256 {
    let asset: Asset1 = Left(get_repayment_asset());
    let amount: Amount1 = Left(debt);

    let hash_ctx1: Ctx8 = jet::sha_256_ctx_8_init();
    let hash_ctx2: Ctx8 = jet::asset_amount_hash(hash_ctx1, asset, amount);

    jet::sha_256_ctx_8_finalize(hash_ctx2)
}

fn is_op_return(output_index: u32) -> bool {
    match jet::output_null_datum(output_index, 0) {
        Some(entry: Option<Either<(u2, u256), Either<u1, u4>>>) => true,
        None => false,
    }
}

// Check helpers

fn check_asset_amounts_eq(asset_amount_1: u64, asset_amount_2: u64) {
    assert!(jet::eq_64(asset_amount_1, asset_amount_2));
}

fn check_assets_eq(asset_bits_1: u256, asset_bits_2: u256) {
    assert!(jet::eq_256(asset_bits_1, asset_bits_2));
}

fn check_script_hashes_eq(script_1: u256, script_2: u256) {
    assert!(jet::eq_256(script_1, script_2));
}

fn check_commitments_eq(commitment_hash_1: u256, commitment_hash_2: u256) {
    assert!(jet::eq_256(commitment_hash_1, commitment_hash_2));
}

// Byte for byte: the same prefix and the same x
fn check_commitment_encodings_eq(commitment_1: (u1, u256), commitment_2: (u1, u256)) {
    let (prefix_bit_1, x_1): (u1, u256) = commitment_1;
    let (prefix_bit_2, x_2): (u1, u256) = commitment_2;

    assert!(jet::eq_1(prefix_bit_1, prefix_bit_2));
    assert!(jet::eq_256(x_1, x_2));
}

fn check_flags_eq(flag_1: bool, flag_2: bool) {
    assert!(jet::eq_1(<bool>::into(flag_1), <bool>::into(flag_2)));
}

// Math helpers

fn safe_add_32(first: u32, second: u32) -> u32 {
    let (carry, result): (bool, u32) = jet::add_32(first, second);

    check_flags_eq(carry, false);

    result
}

// Elliptic curve helpers

// The generator G of secp256k1
fn get_generator() -> Ge {
    (
        0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798,
        0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8
    )
}

// Whether `y` is a square modulo the field's prime
fn is_square(y: Fe) -> bool {
    match jet::fe_square_root(y) {
        Some(root: Fe) => true,
        None => false,
    }
}

// The curve point of a commitment in Elements' encoding. The prefix bit is set exactly when y is
// not a square, and jet::decompress reads it as the parity of y, so this decompresses the point
// with even y and negates it when the square-ness of its y disagrees with the bit: exactly one of
// y and −y is a square, as the field's prime is 3 modulo 4. Fails if x is not on the curve.
fn get_commitment_point(commitment: (u1, u256)) -> Ge {
    let (prefix_bit, x): (u1, u256) = commitment;
    let even_point: Ge = unwrap(jet::decompress((0, x)));
    let (even_x, even_y): (Fe, Fe) = even_point;

    // a square y has the bit 0: a bit equal to the square-ness of y is the other point's
    match jet::eq_1(<bool>::into(is_square(even_y)), prefix_bit) {
        true => jet::ge_negate(even_point),
        false => even_point,
    }
}

// The commitment in Elements' encoding of a curve point: the bit is set exactly when y is not a
// square
fn get_point_commitment(point: Ge) -> (u1, u256) {
    let (x, y): (Fe, Fe) = point;

    (jet::complement_1(<bool>::into(is_square(y))), x)
}

// The debt an installment leaves, D − V, as an affine point. Fails at the point at infinity, which
// no commitment encodes: the installment would pay the debt itself, which the full repayment pays.
fn get_debt_left(debt: (u1, u256), installment_value: (u1, u256)) -> Ge {
    let debt_point: Gej = (get_commitment_point(debt), 1);
    let installment_point: Ge = get_commitment_point(installment_value);
    let debt_left: Gej = jet::gej_ge_add(debt_point, jet::ge_negate(installment_point));

    check_flags_eq(jet::gej_is_infinity(debt_left), false);

    unwrap(jet::gej_normalize(debt_left))
}

// The point plus G, as an affine point
fn get_point_plus_generator(point: Ge) -> Ge {
    let point: Gej = (point, 1);

    unwrap(jet::gej_normalize(jet::gej_ge_add(point, get_generator())))
}

// Ensure functions

fn ensure_output_is_op_return(index: u32) {
    check_flags_eq(is_op_return(index), true);
}

fn ensure_input_script_hash(input_index: u32, expected_script_hash: u256) {
    let script_hash: u256 = get_script_hash(input_index, true);

    check_script_hashes_eq(script_hash, expected_script_hash);
}

fn ensure_output_script_hash(output_index: u32, expected_script_hash: u256) {
    let script_hash: u256 = get_script_hash(output_index, false);

    check_script_hashes_eq(script_hash, expected_script_hash);
}

fn ensure_script_hash_transition(
    input_index: u32,
    output_index: u32,
    expected_input_script_hash: u256,
    expected_output_script_hash: u256
) {
    ensure_input_script_hash(input_index, expected_input_script_hash);
    ensure_output_script_hash(output_index, expected_output_script_hash);
}

fn ensure_input_commitment(input_index: u32, expected_commitment_hash: u256) {
    check_commitments_eq(get_asset_and_amount_hash(input_index, true), expected_commitment_hash);
}

fn ensure_output_commitment(output_index: u32, expected_commitment_hash: u256) {
    check_commitments_eq(get_asset_and_amount_hash(output_index, false), expected_commitment_hash);
}

fn ensure_pinned_output(output_index: u32, expected_commitment_hash: u256, expected_script_hash: u256) {
    ensure_output_commitment(output_index, expected_commitment_hash);
    ensure_output_script_hash(output_index, expected_script_hash);
}

fn ensure_io_asset_and_amount_eq(
    input_index: u32,
    output_index: u32,
    expected_asset_bits: u256,
    expected_amount: u64
) {
    let (input_asset_bits, input_amount): (u256, u64) = get_explicit_asset_and_amount(input_index, true);
    let (output_asset_bits, output_amount): (u256, u64) = get_explicit_asset_and_amount(output_index, false);

    check_assets_eq(input_asset_bits, expected_asset_bits);
    check_assets_eq(input_asset_bits, output_asset_bits);
    check_asset_amounts_eq(input_amount, expected_amount);
    check_asset_amounts_eq(input_amount, output_amount);
}

fn ensure_input_asset_and_amount_burn(
    input_index: u32,
    output_index: u32,
    expected_asset_bits: u256,
    expected_asset_amount: u64
) {
    ensure_io_asset_and_amount_eq(input_index, output_index, expected_asset_bits, expected_asset_amount);

    ensure_output_is_op_return(output_index);
}

// Storage helpers

fn get_is_active_slot_leaf(is_active: bool) -> u256 {
    let is_active_num: u64 = jet::left_pad_low_1_64(<bool>::into(is_active));
    let is_active_num: u256 = <(u128, u128)>::into((0, <(u64, u64)>::into((0, is_active_num))));

    let state_ctx1: Ctx8 = jet::tapdata_init();
    let state_ctx2: Ctx8 = jet::sha_256_ctx_8_add_32(state_ctx1, is_active_num);

    jet::sha_256_ctx_8_finalize(state_ctx2)
}

fn get_debt_slot_leaf(debt: u256) -> u256 {
    let state_ctx1: Ctx8 = jet::tapdata_init();
    let state_ctx2: Ctx8 = jet::sha_256_ctx_8_add_32(state_ctx1, debt);

    jet::sha_256_ctx_8_finalize(state_ctx2)
}

fn get_script_hash_for_storage(is_active: bool, debt: u256) -> u256 {
    let is_active_slot_leaf: u256 = get_is_active_slot_leaf(is_active);
    let debt_slot_leaf: u256 = get_debt_slot_leaf(debt);

    let first_tap_node: u256 = jet::build_tapbranch(jet::tapleaf_hash(), is_active_slot_leaf);
    let tap_node: u256 = jet::build_tapbranch(first_tap_node, debt_slot_leaf);

    // Compute a TapTweak
    let bip0341_key: u256 = 0x50929b74c1a04954b78b4b6035e97a5e078a5a0f28ec96d547bfee9ace803ac0;
    let tweaked_key: u256 = jet::build_taptweak(bip0341_key, tap_node);

    // Turn the TapTweak into a script hash
    let hash_ctx1: Ctx8 = jet::sha_256_ctx_8_init();
    let hash_ctx2: Ctx8 = jet::sha_256_ctx_8_add_2(hash_ctx1, 0x5120); // Segwit v1, length 32
    let hash_ctx3: Ctx8 = jet::sha_256_ctx_8_add_32(hash_ctx2, tweaked_key);

    jet::sha_256_ctx_8_finalize(hash_ctx3)
}

// The flows of the borrower NFT's holder: the installment, the full repayment and the zero-debt
// close. Each spends the borrower NFT at input 0 and the loan at input 1.

fn get_repayment_offer_input_index(start_input_index: u32) -> u32 {
    safe_add_32(start_input_index, 1)
}

fn get_repayment_lender_output_index(start_output_index: u32) -> u32 {
    safe_add_32(start_output_index, 1)
}

// Installment flow

fn get_installment_successor_output_index(start_output_index: u32) -> u32 {
    safe_add_32(start_output_index, 1)
}

fn get_installment_output_index(start_output_index: u32) -> u32 {
    safe_add_32(start_output_index, 2)
}

// The witness's debt is the loan's debt in Elements' encoding: the storage authenticates it.
fn pay_installment(debt: (u1, u256)) {
    let (borrower_nft_input_index, borrower_nft_output_index): (u32, u32) = (0, 0);
    let offer_input_index: u32 = get_repayment_offer_input_index(borrower_nft_input_index);
    let successor_output_index: u32 = get_installment_successor_output_index(borrower_nft_output_index);
    let installment_output_index: u32 = get_installment_output_index(borrower_nft_output_index);

    assert!(jet::eq_32(jet::current_index(), offer_input_index));

    ensure_input_script_hash(
        offer_input_index,
        get_script_hash_for_storage(true, get_debt_hash(debt))
    );

    ensure_io_asset_and_amount_eq(
        borrower_nft_input_index,
        borrower_nft_output_index,
        param::BORROWER_NFT_ASSET_ID,
        1
    );

    // The installment V, to the lender NFT's lock, under the repayment asset
    ensure_output_script_hash(installment_output_index, param::INSTALLMENT_OUTPUT_SCRIPT_HASH);
    let (
        installment_asset,
        installment_value
    ): ((u1, u256), (u1, u256)) = get_confidential_asset_and_amount(installment_output_index, false);
    check_commitment_encodings_eq(installment_asset, get_repayment_asset());

    let debt_left: Ge = get_debt_left(debt, installment_value);

    ensure_output_script_hash(
        successor_output_index,
        get_script_hash_for_storage(true, get_debt_hash(get_point_commitment(debt_left)))
    );

    // The successor carries the collateral: its asset commitment is the loan's plus G and its value
    // commitment the loan's, so the asset and the amount are the loan's.
    let (
        collateral_asset,
        collateral_value
    ): ((u1, u256), (u1, u256)) = get_confidential_asset_and_amount(offer_input_index, true);
    let (
        successor_asset,
        successor_value
    ): ((u1, u256), (u1, u256)) = get_confidential_asset_and_amount(successor_output_index, false);
    check_commitment_encodings_eq(
        successor_asset,
        get_point_commitment(get_point_plus_generator(get_commitment_point(collateral_asset)))
    );
    check_commitment_encodings_eq(successor_value, collateral_value);
}

// Full repayment flow

// The witness's debt hash is the loan's: the storage authenticates it. The repayment carries the
// debt itself, so it pays what the installments left.
fn full_repay_offer(debt_hash: u256) {
    let (borrower_nft_input_index, borrower_nft_output_index): (u32, u32) = (0, 0);
    let offer_input_index: u32 = get_repayment_offer_input_index(borrower_nft_input_index);

    assert!(jet::eq_32(jet::current_index(), offer_input_index));

    ensure_input_script_hash(offer_input_index, get_script_hash_for_storage(true, debt_hash));

    ensure_input_asset_and_amount_burn(
        borrower_nft_input_index,
        borrower_nft_output_index,
        param::BORROWER_NFT_ASSET_ID,
        1
    );

    ensure_pinned_output(
        get_repayment_lender_output_index(borrower_nft_output_index),
        debt_hash,
        param::REPAYMENT_OUTPUT_SCRIPT_HASH
    );
}

// Zero-debt close flow

// SHA-256 of the script of an OP_RETURN with one 32-byte push of the key
fn get_key_reveal_script_hash(key: u256) -> u256 {
    let hash_ctx1: Ctx8 = jet::sha_256_ctx_8_init();
    let hash_ctx2: Ctx8 = jet::sha_256_ctx_8_add_2(hash_ctx1, 0x6a20); // OP_RETURN, push 32 bytes
    let hash_ctx3: Ctx8 = jet::sha_256_ctx_8_add_32(hash_ctx2, key);

    jet::sha_256_ctx_8_finalize(hash_ctx3)
}

// The witness's debt is the loan's debt in Elements' encoding, and the key its blinder k or −k.
// A key with k·G = ±D exists only when no amount is owed: otherwise it would give the discrete
// logarithm of A to base G. Output 1 reveals the key, from which the lender can sweep the
// installments. Simplicity reads an OP_RETURN's data only as hashes, so the key comes from the
// witness and output 1's script must be its OP_RETURN.
fn close_zero_debt(debt: (u1, u256), key: u256) {
    let (borrower_nft_input_index, borrower_nft_output_index): (u32, u32) = (0, 0);
    let offer_input_index: u32 = get_repayment_offer_input_index(borrower_nft_input_index);
    let key_output_index: u32 = get_repayment_lender_output_index(borrower_nft_output_index);

    assert!(jet::eq_32(jet::current_index(), offer_input_index));

    ensure_input_script_hash(
        offer_input_index,
        get_script_hash_for_storage(true, get_debt_hash(debt))
    );

    ensure_input_asset_and_amount_burn(
        borrower_nft_input_index,
        borrower_nft_output_index,
        param::BORROWER_NFT_ASSET_ID,
        1
    );

    // The key is a nonzero scalar below the group's order, not reduced modulo it: k + n would
    // pass as k, and the lender could not use it.
    ensure_output_script_hash(key_output_index, get_key_reveal_script_hash(key));
    assert!(jet::eq_256(jet::scalar_normalize(key), key));
    check_flags_eq(jet::eq_256(key, 0), false);

    // k·G has the x-coordinate of D, which Elements' encoding carries as it is
    let (debt_prefix_bit, debt_x): (u1, u256) = debt;
    assert!(jet::gej_x_equiv(debt_x, jet::generate(key)));
}

// Liquidation flow

fn get_liquidation_lender_nft_indexes(start_input_index: u32, start_output_index: u32) -> (u32, u32) {
    (safe_add_32(start_input_index, 1), start_output_index)
}

// SHA-256 of the salt and the expiry, a 4-byte big-endian block height
fn get_expiry_hash(salt: u256, expiry: u32) -> u256 {
    let hash_ctx1: Ctx8 = jet::sha_256_ctx_8_init();
    let hash_ctx2: Ctx8 = jet::sha_256_ctx_8_add_32(hash_ctx1, salt);
    let hash_ctx3: Ctx8 = jet::sha_256_ctx_8_add_4(hash_ctx2, expiry);

    jet::sha_256_ctx_8_finalize(hash_ctx3)
}

// The program carries only the expiry's salted hash: a spend through another branch reveals a CMR
// that commits to EXPIRY_HASH, from which nobody without the salt can find the expiry. The
// witness's debt hash shows only that the loan is active: the liquidation reads neither the debt
// nor the collateral, which the installments move.
fn liquidate_offer(debt_hash: u256, salt: u256, expiry: u32) {
    let (lending_input_index, lending_output_index): (u32, u32) = (jet::current_index(), 0);
    let (
        lender_nft_input_index,
        lender_nft_output_index
    ): (u32, u32) = get_liquidation_lender_nft_indexes(lending_input_index, lending_output_index);

    assert!(jet::eq_32(lending_input_index, 0));

    ensure_input_script_hash(lending_input_index, get_script_hash_for_storage(true, debt_hash));

    assert!(jet::eq_256(get_expiry_hash(salt, expiry), param::EXPIRY_HASH));
    jet::check_lock_height(expiry);

    ensure_input_asset_and_amount_burn(lender_nft_input_index, lender_nft_output_index, param::LENDER_NFT_ASSET_ID, 1);
}

// Offer acceptance flow

fn get_acceptance_principal_output_index(start_output_index: u32) -> u32 {
    safe_add_32(start_output_index, 1)
}

fn get_acceptance_lender_nft_indexes(start_input_index: u32, start_output_index: u32) -> (u32, u32) {
    (safe_add_32(start_input_index, 1), safe_add_32(start_output_index, 2))
}

fn accept_offer() {
    let (lending_input_index, lending_output_index): (u32, u32) = (jet::current_index(), 0);
    let (
        lender_nft_input_index,
        lender_nft_output_index
    ): (u32, u32) = get_acceptance_lender_nft_indexes(lending_input_index, lending_output_index);
    let principal_output_index: u32 = get_acceptance_principal_output_index(lending_output_index);

    assert!(jet::eq_32(lending_input_index, 0));

    ensure_script_hash_transition(
        lending_input_index,
        lending_output_index,
        get_script_hash_for_storage(false, param::REPAYMENT_COMMITMENT),
        get_script_hash_for_storage(true, param::REPAYMENT_COMMITMENT)
    );

    // The collateral moves to a second pinned commitment: re-using the pending one would need a
    // surjection proof with a zero blinding difference.
    ensure_input_commitment(lending_input_index, param::PENDING_COLLATERAL_COMMITMENT);
    ensure_output_commitment(lending_output_index, param::ACTIVE_COLLATERAL_COMMITMENT);

    ensure_io_asset_and_amount_eq(lender_nft_input_index, lender_nft_output_index, param::LENDER_NFT_ASSET_ID, 1);

    ensure_pinned_output(principal_output_index, param::PRINCIPAL_COMMITMENT, param::PRINCIPAL_OUTPUT_SCRIPT_HASH);
}

// Offer cancellation flow

fn get_cancellation_lender_nft_indexes(start_input_index: u32, start_output_index: u32) -> (u32, u32) {
    (safe_add_32(start_input_index, 1), start_output_index)
}

fn get_cancellation_borrower_nft_indexes(start_input_index: u32, start_output_index: u32) -> (u32, u32) {
    (safe_add_32(start_input_index, 2), safe_add_32(start_output_index, 1))
}

fn cancel_offer() {
    let lending_input_index: u32 = jet::current_index();
    let (
        lender_nft_input_index,
        lender_nft_output_index
    ): (u32, u32) = get_cancellation_lender_nft_indexes(lending_input_index, 0);
    let (
        borrower_nft_input_index,
        borrower_nft_output_index
    ): (u32, u32) = get_cancellation_borrower_nft_indexes(lending_input_index, 0);

    assert!(jet::eq_32(lending_input_index, 0));

    ensure_input_script_hash(
        lending_input_index,
        get_script_hash_for_storage(false, param::REPAYMENT_COMMITMENT)
    );

    ensure_input_commitment(lending_input_index, param::PENDING_COLLATERAL_COMMITMENT);

    ensure_input_asset_and_amount_burn(
        borrower_nft_input_index,
        borrower_nft_output_index,
        param::BORROWER_NFT_ASSET_ID,
        1
    );
    ensure_input_asset_and_amount_burn(
        lender_nft_input_index,
        lender_nft_output_index,
        param::LENDER_NFT_ASSET_ID,
        1
    );
}

// The witness path. A debt is a value commitment in Elements' encoding, whether the low bit of its
// prefix is set and x; a debt hash is h(A, D).
// - Left(Left(())): acceptance; Left(Right(())): cancellation.
// - Right(Left(Left(debt))): an installment.
// - Right(Left(Right(Left(debt_hash)))): the full repayment.
// - Right(Left(Right(Right((debt, key))))): the zero-debt close.
// - Right(Right((debt_hash, salt, expiry))): the liquidation.
fn main() {
    match witness::PATH {
        Left(pending_offer_params: Either<(), ()>) => {
            match pending_offer_params {
                Left(params: ()) => {
                    accept_offer();
                },
                Right(params: ()) => {
                    cancel_offer();
                },
            }
        },
        Right(active_offer_params: Either<Either<(bool, u256), Either<u256, ((bool, u256), u256)>>, (u256, u256, u32)>) => {
            match active_offer_params {
                Left(repayment_params: Either<(bool, u256), Either<u256, ((bool, u256), u256)>>) => {
                    match repayment_params {
                        Left(installment_debt: (bool, u256)) => {
                            pay_installment(get_commitment(installment_debt));
                        },
                        Right(closing_params: Either<u256, ((bool, u256), u256)>) => {
                            match closing_params {
                                Left(debt_hash: u256) => {
                                    full_repay_offer(debt_hash);
                                },
                                Right(zero_debt_params: ((bool, u256), u256)) => {
                                    let (debt, key): ((bool, u256), u256) = zero_debt_params;

                                    close_zero_debt(get_commitment(debt), key);
                                },
                            }
                        },
                    }
                },
                Right(liquidation_params: (u256, u256, u32)) => {
                    let (debt_hash, salt, expiry): (u256, u256, u32) = liquidation_params;

                    liquidate_offer(debt_hash, salt, expiry);
                }
            }
        },
    }
}
